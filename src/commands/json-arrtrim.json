        "summary": "Trims the arrays at a path to an inclusive range of indexes.",
        "complexity": "O(N) where N is the number of elements removed.",
        "group": "json",
        "since": "9.2.0",
        "arity": 5,
        "function": "jsonArrtrimCommand",
        "command_flags": [
            "WRITE",
            "FAST"
        ],
        "acl_categories": [
            "JSON",
            "WRITE",
            "FAST"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "DELETE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "path",
                "type": "string"
            },
            {
                "name": "start",
                "type": "integer"
            },
            {
                "name": "stop",
                "type": "integer"
            }
        ]
    }
}
